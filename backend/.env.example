# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- the model that writes Gonoro's next version (any OpenAI-compatible endpoint) ---
GONORO_LLM_API_KEY=sk-your-key-here
GONORO_LLM_BASE_URL=https://yunwu.ai/v1
GONORO_LLM_MODEL=claude-opus-4-8

# --- the append-only ledger (Supabase). URL + anon key are public by design and RLS-protected. ---
GONORO_SUPABASE_URL=https://mtjwtvggnmjecmapedij.supabase.co
GONORO_SUPABASE_KEY=your-supabase-key
GONORO_UPDATES_TABLE=updates

# --- cadence, in seconds (a new commit every 3 to 5 minutes) ---
GONORO_INTERVAL_MIN_S=180
GONORO_INTERVAL_MAX_S=300
